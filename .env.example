# Required — get a free API key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional — Tavily search (Tier 2 fallback when DuckDuckGo is blocked)
# Free: 1,000 searches/month, no credit card — register at https://app.tavily.com/sign-up
TAVILY_API_KEY=

# Optional — Anthropic Claude (enables prompt caching for long system prompts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — Together AI
TOGETHER_API_KEY=your_together_api_key_here

# Optional — LangSmith tracing (set LANGCHAIN_TRACING_V2=true to enable)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=SalesStrategyAgentTeam
